{
  "name": "slidesaurus-monorepo",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "start": "turbo run start",
    "serve": "turbo run serve",
    "clean": "turbo run clean",
    "build:plugin": "turbo run build --filter=slidesaurus",
    "dev:sample": "turbo run dev --filter=@slidesaurus/sample",
    "dev:docs": "turbo run dev --filter=@slidesaurus/docs",
    "watch:plugin": "pnpm --filter slidesaurus watch",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@slidev/cli": "^52.0.0",
    "@slidev/theme-seriph": "*",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.0.0",
    "prettier": "^3.9.10",
    "turbo": "^2.9.14",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.71.2"
  },
  "pnpm": {
    "overrides": {
      "webpack": "^5.112.0",
      "serialize-javascript": ">=7.0.5",
      "dompurify": ">=3.3.4",
      "webpack-dev-server": "^5.2.6",
      "uuid": ">=14.0.0",
      "js-yaml@3": "^3.15.2",
      "js-yaml@4": "^4.3.2"
    },
    "onlyBuiltDependencies": [
      "core-js",
      "core-js-pure",
      "esbuild",
      "playwright-chromium"
    ]
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@10.33.0"
}
