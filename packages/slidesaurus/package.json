{
  "name": "slidesaurus",
  "version": "1.0.0",
  "description": "A Docusaurus plugin to integrate Slidev presentations into your documentation site",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abraham-ando/slidesaurus.git",
    "directory": "packages/slidesaurus"
  },
  "homepage": "https://github.com/abraham-ando/slidesaurus#readme",
  "bugs": {
    "url": "https://github.com/abraham-ando/slidesaurus/issues"
  },
  "main": "./lib/index.cjs",
  "module": "./lib/index.mjs",
  "types": "./lib/index.d.cts",
  "bin": {
    "slidesaurus": "./lib/cli.cjs"
  },
  "files": [
    "lib",
    "theme"
  ],
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./lib/index.d.mts",
        "default": "./lib/index.mjs"
      },
      "require": {
        "types": "./lib/index.d.cts",
        "default": "./lib/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rollup -c rollup.config.mjs",
    "dev": "rollup -c rollup.config.mjs --watch",
    "clean": "node -e \"require('node:fs').rmSync('lib',{recursive:true,force:true})\"",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc -p theme/tsconfig.json",
    "test": "vitest run",
    "test:integration": "cucumber-js",
    "prepublishOnly": "pnpm run build"
  },
  "peerDependencies": {
    "@docusaurus/core": ">=3.0.0",
    "@slidev/cli": ">=52.0.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "@slidev/cli": {
      "optional": true
    }
  },
  "dependencies": {
    "@docusaurus/logger": "^3.0.0",
    "@docusaurus/utils-validation": "^3.0.0",
    "commander": "^14.0.3",
    "gray-matter": "^4.0.3",
    "jiti": "^2.6.1",
    "js-yaml": "^4.3.2",
    "picocolors": "^1.1.1",
    "prompts": "^2.4.2"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^11.0.0",
    "@docusaurus/types": ">=3.0.0",
    "@rollup/plugin-commonjs": "^29.0.2",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/node": "^22.0.0",
    "@types/prompts": "^2.4.9",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "p-limit": "^7.3.0",
    "rollup": "^4.60.2",
    "rollup-plugin-dts": "^6.4.1",
    "ts-node": "^10.9.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "keywords": [
    "docusaurus",
    "docusaurus-plugin",
    "slidev",
    "presentation",
    "slides"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20.12.0"
  },
  "ts-node": {
    "files": true,
    "transpileOnly": true
  }
}
