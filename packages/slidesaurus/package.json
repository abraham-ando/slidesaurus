{
  "name": "slidesaurus",
  "version": "1.0.0",
  "description": "A Docusaurus plugin to integrate Slidev presentations into your documentation site",
  "main": "./lib/index.cjs",
  "module": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "bin": {
    "slidesaurus": "./lib/cli.cjs"
  },
  "files": [
    "lib",
    "theme"
  ],
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "require": "./lib/index.cjs"
    }
  },
  "scripts": {
    "build": "rollup -c rollup.config.mjs",
    "dev": "rollup -c rollup.config.mjs --watch",
    "clean": "rm -rf lib",
    "test": "vitest run",
    "test:integration": "cucumber-js",
    "prepublishOnly": "pnpm run build"
  },
  "peerDependencies": {
    "@docusaurus/core": ">=3.0.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "dependencies": {
    "commander": "^14.0.3",
    "gray-matter": "^4.0.3",
    "js-yaml": "^4.1.0",
    "p-limit": "^7.3.0",
    "picocolors": "^1.1.1",
    "prompts": "^2.4.2"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^11.0.0",
    "@docusaurus/logger": ">=3.0.0",
    "@docusaurus/types": ">=3.0.0",
    "@docusaurus/utils-validation": ">=3.0.0",
    "@rollup/plugin-commonjs": "^29.0.2",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/node": "^22.0.0",
    "@types/prompts": "^2.4.9",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "rollup": "^4.60.2",
    "rollup-plugin-dts": "^6.4.1",
    "ts-node": "^10.9.0",
    "typescript": "^6.0.3",
    "vitest": "^3.0.0"
  },
  "keywords": [
    "docusaurus",
    "docusaurus-plugin",
    "slidev",
    "presentation",
    "slides"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "ts-node": {
    "files": true,
    "transpileOnly": true
  }
}
