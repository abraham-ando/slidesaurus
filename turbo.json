{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["lib/**", "build/**"]
    },
    "slidesaurus#build": {
      "dependsOn": ["^build"],
      "inputs": [
        "src/**",
        "!src/**/__tests__/**",
        "theme/**",
        "scripts/**",
        "rollup.config.mjs",
        "package.json",
        "tsconfig.json"
      ],
      "outputs": ["lib/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "persistent": true,
      "cache": false
    },
    "start": {
      "dependsOn": ["^build"],
      "persistent": true,
      "cache": false
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test:integration": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "typecheck": {
      "outputs": []
    },
    "clean": {
      "cache": false
    },
    "serve": {
      "dependsOn": ["^build"],
      "persistent": true,
      "cache": false
    }
  }
}
